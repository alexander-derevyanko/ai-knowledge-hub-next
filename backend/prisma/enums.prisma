enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER

  @@map("organization_role")
}

enum DocumentCategory {
  ARCHITECTURE
  DEVELOPMENT
  AI
  PRODUCT
  BUSINESS
  SECURITY

  @@map("document_category")
}

enum DocumentType {
  PDF
  DOCX
  TXT
  MD

  @@map("document_type")
}

enum DocumentStatus {
  READY
  PROCESSING
  FAILED

  @@map("document_status")
}
